    local draggingWin, dragStartWin, startPosWin
    
    TopBar.InputBegan:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and not activeTouchObject then
            activeTouchObject = input
            draggingWin = true
            dragStartWin = input.Position
            startPosWin = MainFrame.Position
            CreateWaterRipple(TopBar, input.Position)
            
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End and input == activeTouchObject then 
                    draggingWin = false 
                    activeTouchObject = nil
                end
            end)
        end
    end)
    
