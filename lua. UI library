local HttpService = game:GetService("HttpService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local WindFramework = {}
WindFramework.__index = WindFramework

local Theme = {
    TopBar = Color3.fromRGB(18, 18, 22),
    Background = Color3.fromRGB(12, 12, 15),
    Accent = Color3.fromRGB(140, 80, 255),
    Text = Color3.fromRGB(240, 240, 245),
    DarkText = Color3.fromRGB(160, 160, 170),
    ElementBackground = Color3.fromRGB(22, 22, 28)
}

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "kwnoHub_UltimateUI"
ScreenGui.ResetOnSpawn = false
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

pcall(function()
    ScreenGui.Parent = CoreGui
end)
if ScreenGui.Parent ~= CoreGui then
    ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
end

-- [1] دالة زر الـ Open
function WindFramework:CreateOpenButton(config)
    config = config or {}
    
    local OpenBtn = Instance.new("TextButton", ScreenGui)
    OpenBtn.Name = "kwno_OpenButton"
    OpenBtn.Size = config.Size or UDim2.new(0, 50, 0, 50)
    OpenBtn.Position = config.Position or UDim2.new(0.05, 0, 0.5, -25)
    OpenBtn.AnchorPoint = Vector2.new(0.5, 0.5)
    OpenBtn.BackgroundColor3 = config.BackgroundColor or Theme.Background
    OpenBtn.Text = config.Text or "kwno"
    OpenBtn.TextColor3 = config.TextColor or Theme.Accent
    OpenBtn.Font = Enum.Font.Arcade
    OpenBtn.TextSize = config.TextSize or 16
    OpenBtn.AutoButtonColor = false
    OpenBtn.BackgroundTransparency = 0.2
    OpenBtn.ZIndex = 9999

    local OpenCorner = Instance.new("UICorner", OpenBtn)
    OpenCorner.CornerRadius = config.CornerRadius or UDim.new(0, 8)

    local OpenStroke = Instance.new("UIStroke", OpenBtn)
    OpenStroke.Color = config.StrokeColor or Theme.Accent
    OpenStroke.Thickness = config.StrokeThickness or 2
    OpenStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

    OpenBtn.MouseEnter:Connect(function()
        TweenService:Create(OpenBtn, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {
            BackgroundColor3 = Theme.Accent,
            TextColor3 = Color3.fromRGB(255, 255, 255)
        }):Play()
    end)
    
    OpenBtn.MouseLeave:Connect(function()
        TweenService:Create(OpenBtn, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {
            BackgroundColor3 = Theme.Background,
            TextColor3 = Theme.Accent
        }):Play()
    end)

    local draggingOB, dragInputOB, dragStartOB, startPosOB
    OpenBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingOB = true
            dragStartOB = input.Position
            startPosOB = OpenBtn.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then 
                    draggingOB = false 
                end
            end)
        end
    end)
    
    OpenBtn.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then 
            dragInputOB = input 
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInputOB and draggingOB then
            local delta = input.Position - dragStartOB
            OpenBtn.Position = UDim2.new(
                startPosOB.X.Scale, 
                startPosOB.X.Offset + delta.X, 
                startPosOB.Y.Scale, 
                startPosOB.Y.Offset + delta.Y
            )
        end
    end)

    return OpenBtn, OpenStroke
end

-- [2] دالة إنشاء النافذة
function WindFramework:Window(options)
    options = options or {}
    local titleText = options.Title or "kwno Hub"

    local WindowObj = {}
    
    local MainFrame = Instance.new("Frame", ScreenGui)
    MainFrame.Name = "kwno_MainFrame"
    MainFrame.Size = UDim2.new(0, 600, 0, 354)
    MainFrame.Position = UDim2.new(0.5, -300, 0.5, -177)
    MainFrame.BackgroundColor3 = Theme.Background
    MainFrame.BorderSizePixel = 0
    MainFrame.ClipsDescendants = true

    local MainCorner = Instance.new("UICorner", MainFrame)
    MainCorner.CornerRadius = UDim.new(0, 10)

    local MainStroke = Instance.new("UIStroke", MainFrame)
    MainStroke.Color = Theme.Accent
    MainStroke.Thickness = 1.5

    local TopBar = Instance.new("Frame", MainFrame)
    TopBar.Size = UDim2.new(1, 0, 0, 40)
    TopBar.BackgroundColor3 = Theme.TopBar
    TopBar.BorderSizePixel = 0

    Instance.new("UICorner", TopBar).CornerRadius = UDim.new(0, 10)

    local FixBar = Instance.new("Frame", TopBar)
    FixBar.Size = UDim2.new(1, 0, 0, 10)
    FixBar.Position = UDim2.new(0, 0, 1, -10)
    FixBar.BackgroundColor3 = Theme.TopBar
    FixBar.BorderSizePixel = 0

    local TitleLabel = Instance.new("TextLabel", TopBar)
    TitleLabel.Size = UDim2.new(1, -100, 1, 0)
    TitleLabel.Position = UDim2.new(0, 15, 0, 0)
    TitleLabel.BackgroundTransparency = 1
    TitleLabel.Text = titleText
    TitleLabel.TextColor3 = Theme.Accent
    TitleLabel.Font = Enum.Font.GothamBold
    TitleLabel.TextSize = 15
    TitleLabel.TextXAlignment = Enum.TextXAlignment.Left

    local OpenBtn, _ = WindFramework:CreateOpenButton({
        Text = "kwno",
        Size = UDim2.new(0, 50, 0, 50)
    })

    local CloseBtn = Instance.new("TextButton", TopBar)
    CloseBtn.Size = UDim2.new(0, 30, 0, 30)
    CloseBtn.Position = UDim2.new(1, -35, 0.5, -15)
    CloseBtn.BackgroundColor3 = Theme.ElementBackground
    CloseBtn.Text = "X"
    CloseBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
    CloseBtn.Font = Enum.Font.GothamBold
    CloseBtn.TextSize = 12

    Instance.new("UICorner", CloseBtn).CornerRadius = UDim.new(0, 6)

    CloseBtn.MouseButton1Click:Connect(function()
        TweenService:Create(MainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 0, 0, 0),
            BackgroundTransparency = 1
        }):Play()
        task.wait(0.2)
        MainFrame.Visible = false
        MainFrame.Size = UDim2.new(0, 600, 0, 354)
        MainFrame.BackgroundTransparency = 0
        OpenBtn.Visible = true
    end)

    OpenBtn.MouseButton1Click:Connect(function()
        OpenBtn.Visible = false
        MainFrame.Visible = true
        MainFrame.Size = UDim2.new(0, 0, 0, 0)
        MainFrame.BackgroundTransparency = 1
        TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, 600, 0, 354),
            BackgroundTransparency = 0
        }):Play()
    end)

    local draggingWin, dragInputWin, dragStartWin, startPosWin
    TopBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingWin = true
            dragStartWin = input.Position
            startPosWin = MainFrame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then 
                    draggingWin = false 
                end
            end)
        end
    end)
    
    TopBar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then 
            dragInputWin = input 
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInputWin and draggingWin then
            local delta = input.Position - dragStartWin
            MainFrame.Position = UDim2.new(
                startPosWin.X.Scale, 
                startPosWin.X.Offset + delta.X, 
                startPosWin.Y.Scale, 
                startPosWin.Y.Offset + delta.Y
            )
        end
    end)

    local Sidebar = Instance.new("ScrollingFrame", MainFrame)
    Sidebar.Size = UDim2.new(0, 140, 1, -50)
    Sidebar.Position = UDim2.new(0, 5, 0, 45)
    Sidebar.BackgroundTransparency = 1
    Sidebar.BorderSizePixel = 0
    Sidebar.CanvasSize = UDim2.new(0, 0, 0, 0)
    Sidebar.ScrollBarThickness = 2

    local SidebarLayout = Instance.new("UIListLayout", Sidebar)
    SidebarLayout.SortOrder = Enum.SortOrder.LayoutOrder
    SidebarLayout.Padding = UDim.new(0, 5)

    local FirstTab = true

    function WindowObj:Tab(tabName)
        local TabObj = {}
        
        local TabBtn = Instance.new("TextButton", Sidebar)
        TabBtn.Size = UDim2.new(1, 0, 0, 32)
        TabBtn.BackgroundColor3 = FirstTab and Theme.ElementBackground or Color3.fromRGB(15, 15, 20)
        TabBtn.Text = "  " .. tabName
        TabBtn.TextColor3 = FirstTab and Theme.Accent or Theme.DarkText
        TabBtn.Font = Enum.Font.GothamSemibold
        TabBtn.TextSize = 13
        TabBtn.TextXAlignment = Enum.TextXAlignment.Left
        TabBtn.AutoButtonColor = false

        Instance.new("UICorner", TabBtn).CornerRadius = UDim.new(0, 6)

        local TabPage = Instance.new("ScrollingFrame", MainFrame)
        TabPage.Size = UDim2.new(1, -155, 1, -50)
        TabPage.Position = UDim2.new(0, 150, 0, 45)
        TabPage.BackgroundTransparency = 1
        TabPage.BorderSizePixel = 0
        TabPage.CanvasSize = UDim2.new(0, 0, 0, 0)
        TabPage.ScrollBarThickness = 3
        TabPage.Visible = FirstTab

        local PageLayout = Instance.new("UIListLayout", TabPage)
        PageLayout.SortOrder = Enum.SortOrder.LayoutOrder
        PageLayout.Padding = UDim.new(0, 8)

        PageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            TabPage.CanvasSize = UDim2.new(0, 0, 0, PageLayout.AbsoluteContentSize.Y + 10)
        end)

        SidebarLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            Sidebar.CanvasSize = UDim2.new(0, 0, 0, SidebarLayout.AbsoluteContentSize.Y + 10)
        end)

        TabBtn.MouseButton1Click:Connect(function()
            for _, child in pairs(MainFrame:GetChildren()) do
                if child:IsA("ScrollingFrame") and child ~= Sidebar then
                    child.Visible = false
                end
            end
            for _, btn in pairs(Sidebar:GetChildren()) do
                if btn:IsA("TextButton") then
                    TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(15, 15, 20)}):Play()
                    btn.TextColor3 = Theme.DarkText
                end
            end
            
            TabPage.Visible = true
            TweenService:Create(TabBtn, TweenInfo.new(0.2), {BackgroundColor3 = Theme.ElementBackground}):Play()
            TabBtn.TextColor3 = Theme.Accent
        end)

        FirstTab = false

        function TabObj:Section(text)
            local SecLbl = Instance.new("TextLabel", TabPage)
            SecLbl.Size = UDim2.new(1, -10, 0, 25)
            SecLbl.BackgroundTransparency = 1
            SecLbl.Text = text
            SecLbl.TextColor3 = Theme.Accent
            SecLbl.Font = Enum.Font.GothamBold
            SecLbl.TextSize = 13
            SecLbl.TextXAlignment = Enum.TextXAlignment.Left
        end

        function TabObj:Button(data)
            data = data or {}
            local BtnFrame = Instance.new("TextButton", TabPage)
            BtnFrame.Size = UDim2.new(1, -10, 0, 35)
            BtnFrame.BackgroundColor3 = Theme.ElementBackground
            BtnFrame.AutoButtonColor = false
            BtnFrame.Text = ""

            Instance.new("UICorner", BtnFrame).CornerRadius = UDim.new(0, 6)

            local Title = Instance.new("TextLabel", BtnFrame)
            Title.Size = UDim2.new(1, -15, 1, 0)
            Title.Position = UDim2.new(0, 10, 0, 0)
            Title.BackgroundTransparency = 1
            Title.Text = data.Title or "Button"
            Title.TextColor3 = Theme.Text
            Title.Font = Enum.Font.GothamMedium
            Title.TextSize = 12
            Title.TextXAlignment = Enum.TextXAlignment.Left

            BtnFrame.MouseButton1Click:Connect(function()
                TweenService:Create(BtnFrame, TweenInfo.new(0.1), {BackgroundColor3 = Theme.Accent}):Play()
                task.wait(0.1)
                TweenService:Create(BtnFrame, TweenInfo.new(0.1), {BackgroundColor3 = Theme.ElementBackground}):Play()
                pcall(data.Callback or function() end)
            end)
        end

        function TabObj:Toggle(data)
            data = data or {}
            local toggled = data.Default or false

            local TogFrame = Instance.new("Frame", TabPage)
            TogFrame.Size = UDim2.new(1, -10, 0, 38)
            TogFrame.BackgroundColor3 = Theme.ElementBackground

            Instance.new("UICorner", TogFrame).CornerRadius = UDim.new(0, 6)

            local Title = Instance.new("TextLabel", TogFrame)
            Title.Size = UDim2.new(1, -60, 1, 0)
            Title.Position = UDim2.new(0, 10, 0, 0)
            Title.BackgroundTransparency = 1
            Title.Text = data.Title or "Toggle"
            Title.TextColor3 = Theme.Text
            Title.Font = Enum.Font.GothamMedium
            Title.TextSize = 12
            Title.TextXAlignment = Enum.TextXAlignment.Left

            local SwitchBox = Instance.new("Frame", TogFrame)
            SwitchBox.Size = UDim2.new(0, 40, 0, 20)
            SwitchBox.Position = UDim2.new(1, -48, 0.5, -10)
            SwitchBox.BackgroundColor3 = toggled and Theme.Accent or Color3.fromRGB(35, 35, 45)

            Instance.new("UICorner", SwitchBox).CornerRadius = UDim.new(1, 0)

            local Circle = Instance.new("Frame", SwitchBox)
            Circle.Size = UDim2.new(0, 16, 0, 16)
            Circle.Position = toggled and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
            Circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)

            Instance.new("UICorner", Circle).CornerRadius = UDim.new(1, 0)

            local ClickBtn = Instance.new("TextButton", TogFrame)
            ClickBtn.Size = UDim2.new(1, 0, 1, 0)
            ClickBtn.BackgroundTransparency = 1
            ClickBtn.Text = ""

            ClickBtn.MouseButton1Click:Connect(function()
                toggled = not toggled
                TweenService:Create(SwitchBox, TweenInfo.new(0.2), {
                    BackgroundColor3 = toggled and Theme.Accent or Color3.fromRGB(35, 35, 45)
                }):Play()
                TweenService:Create(Circle, TweenInfo.new(0.2), {
                    Position = toggled and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
                }):Play()
                pcall(function() (data.Callback or function() end)(toggled) end)
            end)
        end

        function TabObj:Slider(data)
            data = data or {}
            local minVal = data.Min or 0
            local maxVal = data.Max or 100
            local currentValue = data.Default or 50

            local SliderFrame = Instance.new("Frame", TabPage)
            SliderFrame.Size = UDim2.new(1, -10, 0, 50)
            SliderFrame.BackgroundColor3 = Theme.ElementBackground

            Instance.new("UICorner", SliderFrame).CornerRadius = UDim.new(0, 6)

            local Title = Instance.new("TextLabel", SliderFrame)
            Title.Size = UDim2.new(1, -20, 0, 20)
            Title.Position = UDim2.new(0, 10, 0, 5)
            Title.BackgroundTransparency = 1
            Title.Text = data.Title or "Slider"
            Title.TextColor3 = Theme.Text
            Title.Font = Enum.Font.GothamMedium
            Title.TextSize = 12
            Title.TextXAlignment = Enum.TextXAlignment.Left

            local ValueLbl = Instance.new("TextLabel", SliderFrame)
            ValueLbl.Size = UDim2.new(0, 50, 0, 20)
            ValueLbl.Position = UDim2.new(1, -60, 0, 5)
            ValueLbl.BackgroundTransparency = 1
            ValueLbl.Text = tostring(currentValue)
            ValueLbl.TextColor3 = Theme.Accent
            ValueLbl.Font = Enum.Font.GothamBold
            ValueLbl.TextSize = 12
            ValueLbl.TextXAlignment = Enum.TextXAlignment.Right

            local Track = Instance.new("Frame", SliderFrame)
            Track.Size = UDim2.new(1, -20, 0, 6)
            Track.Position = UDim2.new(0, 10, 0, 32)
            Track.BackgroundColor3 = Color3.fromRGB(30, 30, 40)

            Instance.new("UICorner", Track).CornerRadius = UDim.new(1, 0)

            local Fill = Instance.new("Frame", Track)
            Fill.Size = UDim2.new((currentValue - minVal) / (maxVal - minVal), 0, 1, 0)
            Fill.BackgroundColor3 = Theme.Accent

            Instance.new("UICorner", Fill).CornerRadius = UDim.new(1, 0)

            local SliderBtn = Instance.new("TextButton", Track)
            SliderBtn.Size = UDim2.new(1, 0, 1, 0)
            SliderBtn.BackgroundTransparency = 1
            SliderBtn.Text = ""

            local sliding = false
            SliderBtn.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    sliding = true
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    sliding = false
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    local pos = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
                    currentValue = math.floor(minVal + ((maxVal - minVal) * pos))
                    Fill.Size = UDim2.new(pos, 0, 1, 0)
                    ValueLbl.Text = tostring(currentValue)
                    pcall(function() (data.Callback or function() end)(currentValue) end)
                end
            end)
        end

        -- [أداة اختيار اللون المخصصة ColorPicker]
        function TabObj:ColorPicker(data)
            data = data or {}
            local currentColor = data.Default or Color3.fromRGB(140, 80, 255)

            local PickerFrame = Instance.new("Frame", TabPage)
            PickerFrame.Size = UDim2.new(1, -10, 0, 42)
            PickerFrame.BackgroundColor3 = Theme.ElementBackground

            Instance.new("UICorner", PickerFrame).CornerRadius = UDim.new(0, 6)

            local Title = Instance.new("TextLabel", PickerFrame)
            Title.Size = UDim2.new(1, -60, 1, 0)
            Title.Position = UDim2.new(0, 10, 0, 0)
            Title.BackgroundTransparency = 1
            Title.Text = data.Title or "Color Picker"
            Title.TextColor3 = Theme.Text
            Title.Font = Enum.Font.GothamMedium
            Title.TextSize = 12
            Title.TextXAlignment = Enum.TextXAlignment.Left

            local ColorDisplay = Instance.new("Frame", PickerFrame)
            ColorDisplay.Size = UDim2.new(0, 32, 0, 22)
            ColorDisplay.Position = UDim2.new(1, -42, 0.5, -11)
            ColorDisplay.BackgroundColor3 = currentColor

            Instance.new("UICorner", ColorDisplay).CornerRadius = UDim.new(0, 4)
            
            local ColorStroke = Instance.new("UIStroke", ColorDisplay)
            ColorStroke.Color = Color3.fromRGB(255, 255, 255)
            ColorStroke.Thickness = 1

            local ColorBtn = Instance.new("TextButton", PickerFrame)
            ColorBtn.Size = UDim2.new(1, 0, 1, 0)
            ColorBtn.BackgroundTransparency = 1
            ColorBtn.Text = ""

            ColorBtn.MouseButton1Click:Connect(function()
                -- تبديل سريع أو دوراني للألوان التلقائية (أو فتح لوحة مخصصة)
                -- هنا جعلناها تتغير بين عدة ألوان مميزة عند الضغط
                if currentColor == Color3.fromRGB(140, 80, 255) then
                    currentColor = Color3.fromRGB(255, 50, 50) -- أحمر
                elseif currentColor == Color3.fromRGB(255, 50, 50) then
                    currentColor = Color3.fromRGB(50, 255, 50) -- أخضر
                elseif currentColor == Color3.fromRGB(50, 255, 50) then
                    currentColor = Color3.fromRGB(50, 150, 255) -- أزرق
                else
                    currentColor = Color3.fromRGB(140, 80, 255) -- بنفسجي
                end

                TweenService:Create(ColorDisplay, TweenInfo.new(0.2), {BackgroundColor3 = currentColor}):Play()
                pcall(function() (data.Callback or function() end)(currentColor) end)
            end)
        end

        return TabObj
    end

    return WindowObj
end

function WindFramework:Notify(data)
    data = data or {}
    local NotifCard = Instance.new("Frame", ScreenGui)
    NotifCard.Size = UDim2.new(0, 260, 0, 65)
    NotifCard.Position = UDim2.new(1, 280, 0.85, 0)
    NotifCard.BackgroundColor3 = Theme.Background
    NotifCard.ZIndex = 99999

    Instance.new("UICorner", NotifCard).CornerRadius = UDim.new(0, 8)
    
    local Stroke = Instance.new("UIStroke", NotifCard)
    Stroke.Color = Theme.Accent
    Stroke.Thickness = 1.5

    local Title = Instance.new("TextLabel", NotifCard)
    Title.Size = UDim2.new(1, -15, 0, 22)
    Title.Position = UDim2.new(0, 10, 0, 8)
    Title.BackgroundTransparency = 1
    Title.Text = data.Title or "kwno Hub"
    Title.TextColor3 = Theme.Accent
    Title.Font = Enum.Font.GothamBold
    Title.TextSize = 13
    Title.TextXAlignment = Enum.TextXAlignment.Left

    local Content = Instance.new("TextLabel", NotifCard)
    Content.Size = UDim2.new(1, -15, 0, 25)
    Content.Position = UDim2.new(0, 10, 0, 30)
    Content.BackgroundTransparency = 1
    Content.Text = data.Content or ""
    Content.TextColor3 = Theme.Text
    Content.Font = Enum.Font.Gotham
    Content.TextSize = 11
    Content.TextXAlignment = Enum.TextXAlignment.Left
    Content.TextWrapped = true

    TweenService:Create(NotifCard, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Position = UDim2.new(1, -275, 0.85, 0)
    }):Play()

    task.delay(data.Duration or 3, function()
        TweenService:Create(NotifCard, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Position = UDim2.new(1, 280, 0.85, 0)
        }):Play()
        task.wait(0.35)
        NotifCard:Destroy()
    end)
end

return WindFramework
 
