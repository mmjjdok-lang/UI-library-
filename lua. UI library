            SelectBtn.MouseButton1Click:Connect(function()
                isOpen = not isOpen
                local targetHeight = isOpen and math.min(130, (#optionsList * 32) + 12) + 44 or 40
                local listHeight = isOpen and math.min(130, (#optionsList * 32) + 12) or 0
                
                TweenService:Create(DropFrame, TweenInfo.new(0.25), {Size = UDim2.new(1, -10, 0, targetHeight)}):Play()
                TweenService:Create(ListContainer, TweenInfo.new(0.25), {Size = UDim2.new(1, -24, 0, listHeight)}):Play()
            end)
        end

        -- نظام القائمة المنسدلة للأزرار التنفيذية المتعددة
        function TabObj:ActionDropdown(data)
            data = data or {}
            local actions = data.Actions or {}
            local isOpen = false

            local DropFrame = Instance.new("Frame", TabPage)
            DropFrame.Size = UDim2.new(1, -10, 0, 40)
            DropFrame.BackgroundColor3 = Theme.ElementBackground
            DropFrame.ClipsDescendants = true

            Instance.new("UICorner", DropFrame).CornerRadius = UDim.new(0, 6)

            local Title = Instance.new("TextLabel", DropFrame)
            Title.Size = UDim2.new(1, -130, 0, 40)
            Title.Position = UDim2.new(0, 12, 0, 0)
            Title.BackgroundTransparency = 1
            Title.Text = data.Title or "Action Dropdown"
            Title.TextColor3 = Theme.Text
            Title.Font = Enum.Font.GothamMedium
            Title.TextSize = 12
            Title.TextXAlignment = Enum.TextXAlignment.Left

            local SelectBtn = Instance.new("TextButton", DropFrame)
            SelectBtn.Size = UDim2.new(0, 110, 0, 26)
            SelectBtn.Position = UDim2.new(1, -120, 0.5, -13)
            SelectBtn.BackgroundColor3 = Theme.Accent
            SelectBtn.Text = "قائمة الأزرار ▾"
            SelectBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            SelectBtn.Font = Enum.Font.GothamBold
            SelectBtn.TextSize = 11

            Instance.new("UICorner", SelectBtn).CornerRadius = UDim.new(0, 4)

            local ListContainer = Instance.new("ScrollingFrame", DropFrame)
            ListContainer.Size = UDim2.new(1, -24, 0, 0)
            ListContainer.Position = UDim2.new(0, 12, 0, 44)
            ListContainer.BackgroundTransparency = 1
            ListContainer.BorderSizePixel = 0
            ListContainer.CanvasSize = UDim2.new(0, 0, 0, 0)
            ListContainer.ScrollBarThickness = 2

            local ListLayout = Instance.new("UIListLayout", ListContainer)
            ListLayout.SortOrder = Enum.SortOrder.LayoutOrder
            ListLayout.Padding = UDim.new(0, 4)

            ListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                ListContainer.CanvasSize = UDim2.new(0, 0, 0, ListLayout.AbsoluteContentSize.Y)
            end)

            for actName, actCallback in pairs(actions) do
                local ActBtn = Instance.new("TextButton", ListContainer)
                ActBtn.Size = UDim2.new(1, 0, 0, 28)
                ActBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
                ActBtn.Text = tostring(actName)
                ActBtn.TextColor3 = Theme.Accent
                ActBtn.Font = Enum.Font.GothamSemibold
                ActBtn.TextSize = 11

                Instance.new("UICorner", ActBtn).CornerRadius = UDim.new(0, 4)

                ActBtn.MouseButton1Click:Connect(function()
                    isOpen = false
                    TweenService:Create(DropFrame, TweenInfo.new(0.2), {Size = UDim2.new(1, -10, 0, 40)}):Play()
                    TweenService:Create(ListContainer, TweenInfo.new(0.2), {Size = UDim2.new(1, -24, 0, 0)}):Play()
                    pcall(actCallback)
                end)
            end

            SelectBtn.MouseButton1Click:Connect(function()
                isOpen = not isOpen
                local count = 0 for _ in pairs(actions) do count = count + 1 end
                local targetHeight = isOpen and math.min(130, (count * 32) + 12) + 44 or 40
                local listHeight = isOpen and math.min(130, (count * 32) + 12) or 0
                
                TweenService:Create(DropFrame, TweenInfo.new(0.25), {Size = UDim2.new(1, -10, 0, targetHeight)}):Play()
                TweenService:Create(ListContainer, TweenInfo.new(0.25), {Size = UDim2.new(1, -24, 0, listHeight)}):Play()
            end)
        end

        return TabObj
    end

    return WindowObj
end

-- نظام الإشعارات المنبثقة
function WindFramework:Notify(data)
    data = data or {}
    local NotifCard = Instance.new("Frame", ScreenGui)
    NotifCard.Size = UDim2.new(0, 260, 0, 65)
    NotifCard.Position = UDim2.new(1, 280, 0.85, 0)
    NotifCard.BackgroundColor3 = Theme.Background
    NotifCard.ZIndex = 99999

    Instance.new("UICorner", NotifCard).CornerRadius = UDim.new(0, 8)
    local stroke = Instance.new("UIStroke", NotifCard)
    stroke.Color = Theme.Accent
    stroke.Thickness = 1.5

    local Title = Instance.new("TextLabel", NotifCard)
    Title.Size = UDim2.new(1, -15, 0, 22)
    Title.Position = UDim2.new(0, 10, 0, 8)
    Title.BackgroundTransparency = 1
    Title.Text = data.Title or CurrentLang.NotifTitle
    Title.TextColor3 = Theme.Accent
    Title.Font = Enum.Font.GothamBold
    Title.TextSize = 13
    Title.TextXAlignment = Enum.TextXAlignment.Left

    local Content = Instance.new("TextLabel", NotifCard)
    Content.Size = UDim2.new(1, -15, 0, 25)
    Content.Position = UDim2.new(0, 10, 0, 30)
    Content.BackgroundTransparency = 1
    Content.Text = data.Content or CurrentLang.NotifContent
    Content.TextColor3 = Theme.Text
    Content.Font = Enum.Font.Gotham
    Content.TextSize = 11
    Content.TextXAlignment = Enum.TextXAlignment.Left
    Content.TextWrapped = true

    TweenService:Create(NotifCard, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Position = UDim2.new(1, -275, 0.85, 0)
    }):Play()

    task.delay(data.Duration or 3, function()
        TweenService:Create(NotifCard, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Position = UDim2.new(1, 280, 0.85, 0)
        }):Play()
        task.wait(0.35)
        NotifCard:Destroy()
    end)
end

