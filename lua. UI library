-- دالة تأثير قطرة الماء المتقدمة (تظهر فقط عند لمس الواجهة الرئيسية)
local function CreateWaterRipple(parentFrame, inputPos)
    local ripple = Instance.new("Frame", parentFrame)
    ripple.Name = "WaterRipple"
    ripple.AnchorPoint = Vector2.new(0.5, 0.5)
    ripple.BackgroundColor3 = Theme.Accent
    ripple.BackgroundTransparency = 0.4
    ripple.BorderSizePixel = 0
    ripple.ZIndex = 999
    
    local absolutePos = parentFrame.AbsolutePosition
    ripple.Position = UDim2.new(0, inputPos.X - absolutePos.X, 0, inputPos.Y - absolutePos.Y)
    ripple.Size = UDim2.new(0, 0, 0, 0)

    local corner = Instance.new("UICorner", ripple)
    corner.CornerRadius = UDim.new(1, 0)

    TweenService:Create(ripple, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 120, 0, 120),
        BackgroundTransparency = 1
    }):Play()

    task.delay(0.5, function()
        ripple:Destroy()
    end)
end

-- زر فتح الواجهة الخارجي
function WindFramework:CreateOpenButton(config)
    config = config or {}
    
    local OpenBtn = Instance.new("TextButton", ScreenGui)
    OpenBtn.Name = "kwno_OpenButton"
    OpenBtn.Size = config.Size or UDim2.new(0, 50, 0, 50)
    OpenBtn.Position = config.Position or UDim2.new(0.05, 0, 0.5, -25)
    OpenBtn.AnchorPoint = Vector2.new(0.5, 0.5)
    OpenBtn.BackgroundColor3 = config.BackgroundColor or Theme.Background
    OpenBtn.Text = CurrentLang.OpenText
    OpenBtn.TextColor3 = config.TextColor or Theme.Accent
    OpenBtn.Font = Enum.Font.Arcade
    OpenBtn.TextSize = 16
    OpenBtn.AutoButtonColor = false
    OpenBtn.BackgroundTransparency = 0.2
    OpenBtn.ZIndex = 9999

    Instance.new("UICorner", OpenBtn).CornerRadius = UDim.new(0, 8)
    local stroke = Instance.new("UIStroke", OpenBtn)
    stroke.Color = Theme.Accent
    stroke.Thickness = 2

    local draggingOB, dragInputOB, dragStartOB, startPosOB
    OpenBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingOB = true
            dragStartOB = input.Position
            startPosOB = OpenBtn.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then draggingOB = false end
            end)
        end
    end)
    
    OpenBtn.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then 
            dragInputOB = input 
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInputOB and draggingOB then
            local delta = input.Position - dragStartOB
            OpenBtn.Position = UDim2.new(startPosOB.X.Scale, startPosOB.X.Offset + delta.X, startPosOB.Y.Scale, startPosOB.Y.Offset + delta.Y)
        end
    end)

    return OpenBtn
end

