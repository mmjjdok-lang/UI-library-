function WindFramework:Notify(options)
    options = options or {}
    local NotifCard = Instance.new("Frame")
    NotifCard.Size = UDim2.new(1, 0, 0, 60)
    NotifCard.BackgroundColor3 = Theme.TopBar
    NotifCard.Position = UDim2.new(1, 50, 0, 0)
    NotifCard.Parent = NotifContainer

    Instance.new("UICorner", NotifCard).CornerRadius = UDim.new(0, 6)
    local NStroke = Instance.new("UIStroke", NotifCard)
    NStroke.Color = Theme.Accent
    NStroke.Thickness = 1.5

    local NTitle = Instance.new("TextLabel", NotifCard)
    NTitle.Size = UDim2.new(1, -20, 0, 25)
    NTitle.Position = UDim2.new(0, 10, 0, 5)
    NTitle.BackgroundTransparency = 1
    NTitle.Text = options.Title or "تنبيه نظام"
    NTitle.TextColor3 = Theme.Accent
    NTitle.Font = Enum.Font.GothamBold
    NTitle.TextSize = 14
    NTitle.TextXAlignment = Enum.TextXAlignment.Left

    local NDesc = Instance.new("TextLabel", NotifCard)
    NDesc.Size = UDim2.new(1, -20, 0, 20)
    NDesc.Position = UDim2.new(0, 10, 0, 30)
    NDesc.BackgroundTransparency = 1
    NDesc.Text = options.Content or "..."
    NDesc.TextColor3 = Theme.Text
    NDesc.Font = Enum.Font.Gotham
    NDesc.TextSize = 12
    NDesc.TextXAlignment = Enum.TextXAlignment.Left

    TweenService:Create(NotifCard, TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Position = UDim2.new(0, 0, 0, 0)}):Play()

    task.delay(options.Duration or 3, function()
        TweenService:Create(NotifCard, TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {Position = UDim2.new(1, 50, 0, 0), BackgroundTransparency = 1}):Play()
        task.wait(0.4)
        NotifCard:Destroy()
    end)
end

